<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/style.css" />

    <title>Editing <%= gpu.name %></title>
  </head>
  <body>
    <a class="gpus-index-link" href="/gpus">
      <div class="index-link-text">Back to Gpus</div>
    </a>

    <h1>Editing <%= gpu.name %></h1>

    <form action="/gpus/<%= gpu._id %>?_method=PUT" method="post">
      <label for="name">Name:</label>
      <input
        type="text"
        name="name"
        id="name"
        value="<%= gpu.name %>"
      />

      <div class="checkbox-div">
        <label for="isCooledDown">Ready to get used?</label>
        <input
          type="checkbox"
          name="isCooledDown"
          id="isCooledDown"
          <%if(gpu.isCooledDown){ %>
            checked
          <% }%>
          />
      </div>

      <button type="submit">Add Gpu</button>
    </form>
  </body>
</html>